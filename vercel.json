{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/debug/ping",
      "destination": "/api/debug/ping.ts"
    },
    {
      "source": "/api/debug/env",
      "destination": "/api/debug/env.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
